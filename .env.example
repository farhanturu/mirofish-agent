# ================================================================
# MiroFish Agent — Konfigurasi LLM
# ================================================================
# Copy file ini ke .env lalu isi API key yang kamu punya
# Minimal isi SALAH SATU provider untuk bisa jalan
#
# Contoh:
#   cp .env.example .env
#   nano .env  # edit API key
# ================================================================

# ---------------------------------------------------------------
# PROVIDER 1: Groq (GRATIS!) — Rekomendasi Utama
# Dapatkan: https://console.groq.com/keys
# Biaya: GRATIS 30 RPM
# Models: Llama 3.3 70B, Mixtral 8x7B, Llama 3.1 8B
# Kecepatan: SANGAT CEPAT (500+ tokens/detik)
# ---------------------------------------------------------------
#GROQ_API_KEY=gsk_your_key_here
#GROQ_BASE_URL=https://api.groq.com/openai/v1
#GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------
# PROVIDER 2: Google Gemini (GRATIS!)
# Dapatkan: https://aistudio.google.com/apikey
# Biaya: GRATIS 1500 request/hari
# Models: gemini-2.0-flash, gemini-2.0-flash-lite
# Kecepatan: Sedang
# ---------------------------------------------------------------
#GEMINI_API_KEY=your_gemini_key_here
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------
# PROVIDER 3: Atomesus (Prime Account)
# Dapatkan: https://www.atomesus.com/dashboard
# Biaya: Tergantung plan (ada free trial)
# Kecepatan: Tinggi, OpenAI-compatible
# ---------------------------------------------------------------
#ATOMESUS_API_KEY=atms_sk_your_key_here
#ATOMESUS_BASE_URL=https://api.atomesus.com/v1
#ATOMESUS_MODEL=cipher

# ---------------------------------------------------------------
# PROVIDER 4: Together AI (GRATIS!)
# Dapatkan: https://api.together.xyz/settings/api-keys
# Biaya: GRATIS 60 RPM
# Models: Llama 3.1 8B, Mixtral 8x7B, Qwen 2.5 72B
# ---------------------------------------------------------------
#TOGETHER_API_KEY=your_together_key_here
#TOGETHER_BASE_URL=https://api.together.xyz/v1
#TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ---------------------------------------------------------------
# PROVIDER 5: Ollama (Self-Hosted / Lokal)
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Jalankan: ollama pull llama3.2
# Biaya: GRATIS 100% (lokal)
# ---------------------------------------------------------------
#OLLAMA_BASE_URL=http://localhost:11434/v1
#OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------
# ZEP MEMORY GRAPH (Opsional)
# Dapatkan: https://app.getzep.com/
# Biaya: GRATIS untuk penggunaan ringan
# ---------------------------------------------------------------
#ZEP_API_KEY=your_zep_key_here

# ---------------------------------------------------------------
# FEATURE FLAGS
# ---------------------------------------------------------------
ENABLE_GROQ=true
ENABLE_GEMINI=true
